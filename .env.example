# Copy this file to ".env" and keep ".env" private. Never commit ".env".
#
# The four DB_* values below match docker-compose.yml, so the defaults work
# for local teaching. Change them only when you connect to a different
# PostgreSQL server.

# Address of the PostgreSQL server started by "docker compose up -d".
DB_HOST=localhost
# Port PostgreSQL listens on inside the container.
DB_PORT=5432
# Name of the database created on first start.
DB_NAME=edudb
# Database user (the Docker image uses "postgres" by default).
DB_USER=postgres
# Database password (must match POSTGRES_PASSWORD in docker-compose.yml).
DB_PASSWORD=postgres

# Secret key used to sign the session cookie. Replace the value with a long,
# random string. Generate one with this command and paste the output:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Do not reuse the sample value below in any real deployment.
SECRET_KEY=change-me-to-a-random-string
